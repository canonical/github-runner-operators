#!/usr/bin/env node
import { execFileSync } from 'node:child_process';
import fs from 'node:fs';
import path from 'node:path';

const MARKER = /<!-- foreman:meta\s*([\s\S]*?)-->/;

function repoRoot() {
	try {
		return execFileSync('git', ['rev-parse', '--show-toplevel'], {
			encoding: 'utf8',
			stdio: ['ignore', 'pipe', 'ignore']
		}).trim();
	} catch {
		return process.cwd();
	}
}

const root = repoRoot();
const file = path.join(root, '.opencode', 'decisions.md');
const lockFile = path.join(root, '.opencode', '.decisions.lock');

function emptyState() {
	return { version: 1, nextQuestion: 1, nextDecision: 1, questions: [], decisions: [] };
}

function readState() {
	try {
		const text = fs.readFileSync(file, 'utf8');
		const match = text.match(MARKER);
		if (!match) return emptyState();
		const parsed = JSON.parse(match[1].trim());
		return {
			version: 1,
			nextQuestion: Number(parsed.nextQuestion) || 1,
			nextDecision: Number(parsed.nextDecision) || 1,
			questions: Array.isArray(parsed.questions) ? parsed.questions : [],
			decisions: Array.isArray(parsed.decisions) ? parsed.decisions : []
		};
	} catch {
		return emptyState();
	}
}

function render(state) {
	const meta = JSON.stringify(state, null, 2);
	const lines = ['# Houston decisions', '', '<!-- foreman:meta', meta, '-->', ''];
	const open = state.questions.filter((q) => q.status === 'open');
	const answered = state.questions.filter((q) => q.status !== 'open');
	lines.push('## Open questions', '');
	if (!open.length) lines.push('_None._', '');
	for (const q of open) {
		lines.push(`### ${q.id}`, '', q.question, '');
		if (q.options?.length) lines.push(`Options: ${q.options.join(' / ')}`, '');
	}
	lines.push('## Answered questions', '');
	if (!answered.length) lines.push('_None._', '');
	for (const q of answered) {
		lines.push(`### ${q.id}`, '', q.question, '', `**Answer:** ${q.answer || ''}`, '');
	}
	lines.push('## Settled decisions', '');
	if (!state.decisions.length) lines.push('_None._', '');
	for (const d of state.decisions) {
		lines.push(`### ${d.id}`, '', d.text, '');
	}
	return lines.join('\n');
}

function writeState(state) {
	fs.mkdirSync(path.dirname(file), { recursive: true });
	const tmp = `${file}.${process.pid}.tmp`;
	fs.writeFileSync(tmp, render(state), 'utf8');
	fs.renameSync(tmp, file);
}

function withLock(fn) {
	fs.mkdirSync(path.dirname(file), { recursive: true });
	const started = Date.now();
	let handle;
	while (!handle) {
		try {
			handle = fs.openSync(lockFile, 'wx');
		} catch (error) {
			if (error.code !== 'EEXIST') throw error;
			try {
				const age = Date.now() - fs.statSync(lockFile).mtimeMs;
				if (age > 10000) fs.unlinkSync(lockFile);
			} catch {
				// retry
			}
			if (Date.now() - started > 5000) throw new Error('Timed out waiting for decisions lock');
			Atomics.wait(new Int32Array(new SharedArrayBuffer(4)), 0, 0, 50);
		}
	}
	try {
		return fn();
	} finally {
		fs.closeSync(handle);
		try {
			fs.unlinkSync(lockFile);
		} catch {
			// already gone
		}
	}
}

const [command, ...args] = process.argv.slice(2);

if (!command || command === 'help' || command === '--help') {
	console.log(`foreman-decisions

  ask "<question>" [--option "<option>"]...
  decide "<decision>"
  answer <question-id> "<answer>"
  list [--json]
  open-count
`);
	process.exit(0);
}

if (command === 'ask') {
	const question = args.shift();
	if (!question) throw new Error('question is required');
	const options = [];
	for (let i = 0; i < args.length; i += 1) {
		if (args[i] === '--option' && args[i + 1]) {
			options.push(args[++i]);
		}
	}
	withLock(() => {
		const state = readState();
		const id = `Q-${String(state.nextQuestion).padStart(3, '0')}`;
		state.nextQuestion += 1;
		state.questions.push({
			id,
			status: 'open',
			askedAt: new Date().toISOString(),
			question,
			options,
			answer: null,
			answeredAt: null
		});
		writeState(state);
		console.log(id);
	});
} else if (command === 'decide') {
	const text = args.join(' ').trim();
	if (!text) throw new Error('decision text is required');
	withLock(() => {
		const state = readState();
		const id = `D-${String(state.nextDecision).padStart(3, '0')}`;
		state.nextDecision += 1;
		state.decisions.push({ id, decidedAt: new Date().toISOString(), text });
		writeState(state);
		console.log(id);
	});
} else if (command === 'answer') {
	const id = args.shift();
	const answer = args.join(' ').trim();
	if (!id || !answer) throw new Error('usage: answer <question-id> "<answer>"');
	withLock(() => {
		const state = readState();
		const question = state.questions.find((q) => q.id === id);
		if (!question) throw new Error(`question ${id} not found`);
		question.status = 'answered';
		question.answer = answer;
		question.answeredAt = new Date().toISOString();
		writeState(state);
		console.log(id);
	});
} else if (command === 'open-count') {
	const state = readState();
	console.log(state.questions.filter((q) => q.status === 'open').length);
} else if (command === 'list') {
	const state = readState();
	if (args.includes('--json')) {
		console.log(JSON.stringify(state, null, 2));
	} else {
		for (const q of state.questions.filter((q) => q.status === 'open')) {
			console.log(`${q.id}: ${q.question}`);
		}
	}
} else {
	throw new Error(`unknown command: ${command}`);
}
